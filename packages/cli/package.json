{
  "name": "ete",
  "version": "0.0.1",
  "description": "LLM-authored, deterministically replayed E2E tests for CI",
  "type": "module",
  "bin": {
    "ete": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ete/core": "workspace:*",
    "@ete/driver-browser": "workspace:*",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.2",
    "zod": "^4.6.4"
  }
}
